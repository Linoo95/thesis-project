module TestCombSeq(
    clk: input clock,
    rst: input reset,
    a: input logic<8>,
    comb_out: output logic<8>,
    y: output logic<8>,
){
    var q: logic<8>;

    assign comb_out = a + 1;

    always_ff(clk, rst){
        if_reset{
            q = 0;
        }else {
            q = comb_out;
        }
    }
    assign y = q;
}